# Local Supabase defaults. Use values printed by `supabase status -o env`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:54322/postgres

# Optional server-only settings.
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
OUTBOX_PROCESSOR_SECRET=
OUTBOX_PROCESSOR_SECRET_PREVIOUS=

# Local-only baseline setup. Use seven distinct, unique passwords of 12+ characters.
HRMS_SEED_ENV=development
HRMS_DEV_SUPER_ADMIN_PASSWORD=
HRMS_DEV_ADMIN_PASSWORD=
HRMS_DEV_HR_ADMIN_PASSWORD=
HRMS_DEV_DEPT_HEAD_PASSWORD=
HRMS_DEV_SUPERVISOR_PASSWORD=
HRMS_DEV_EMPLOYEE_PASSWORD=
HRMS_DEV_OPS_MANAGER_PASSWORD=
