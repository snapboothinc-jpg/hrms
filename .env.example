# Local Supabase defaults. Fill in the keys printed by `npx supabase status -o env`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional server-only settings.
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
OUTBOX_PROCESSOR_SECRET=
OUTBOX_PROCESSOR_SECRET_PREVIOUS=

# Set only when intentionally seeding an isolated development database.
HRMS_SEED_ENV=
HRMS_SEED_PASSWORD=
